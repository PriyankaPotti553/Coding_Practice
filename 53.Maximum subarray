class Solution {
    public int maxSubArray(int[] nums) {
        int max = nums[0];
        int sum=0;
        for(int r=0;r<nums.length;r++){
            sum+=nums[r];
            max=Math.max(sum,max);
            if(sum<0){
                sum=0;
            }
        }
        return max;
    }
}
